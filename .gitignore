# ===== Roblox / Rojo =====
# Place & model files are BUILD OUTPUTS — your source of truth is src/ + the
# Rojo project. These get regenerated by `rojo build`, so don't track them.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
# Studio lock files (created while a place file is open in Studio)
*.rbxl.lock
*.rbxlx.lock

# Rojo-generated sourcemap (for Luau LSP); regenerate with `rojo sourcemap`
sourcemap.json

# ===== Package managers (Wally) — ignored in case you add Wally later =====
# (wally.toml / wally.lock SHOULD be committed; the installed folders should not)
/Packages/
/ServerPackages/
/DevPackages/

# ===== Local backups / scratch =====
# Old-build snapshot saved during the version recovery on 2026-06-26
_src_backup_oldbuild_*/
# Cold backup of the good place (regenerable from src/) — kept locally, not in git
good.rbxl

# ===== Tooling / editor =====
node_modules/
.vscode/
.luarc.json

# ===== Claude Code (machine-local) =====
# Per-machine permissions/settings — not meant to be shared
.claude/settings.local.json

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini
